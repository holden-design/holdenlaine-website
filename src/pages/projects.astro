
---
import SEO from '../components/SEO.astro';
import Cursor from '../components/Cursor.astro';
import HamburgerMenu from '../components/HamburgerMenu.astro';
import MobileLogo from '../components/MobileLogo.astro';
import Logo from '../components/Logo.astro';
import projects from '../../public/data/projects.json';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="keywords" content="Holden Laine portfolio, photography projects, fotograafia, content creation, social media content, UGC, portrait photography, fashion photography" />
    <SEO 
      title="Portfolio - Holden Laine Photography Projects & Content"
      titleEt="Portfell - Holden Laine Fotograafia Projektid"
      description="Explore Holden Laine's professional photography portfolio featuring portrait, fashion, editorial, social media content creation, UGC, and commercial projects."
      descriptionEt="Uurige Holden Laine professionaalse fotograafia portfelli, mis sisaldab portreid, moodi, toimetuslikke, sotsiaalmeedia sisutootmis-, UGC ja kommertsprojekte."
      type="website"
    />
    <link href="https://vjs.zencdn.net/7.20.3/video-js.css" rel="stylesheet" />
    <style is:global>
      body {
        margin: 0;
        font-family: "Helvetica Neue", Helvetica;
        background: #fff;
        color: #222;
        display: block;
        -webkit-user-select: none;
        user-select: none;
      }
      img, video {
        -webkit-user-drag: none;
        user-select: none;
        -webkit-user-select: none;
      }
      #letterfall-canvas {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        pointer-events: none;
      }
      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem;
        position: relative;
        z-index: 1;
      }
      .sidebar {
        position: fixed;
        left: 2rem;
        top: 2rem;
        width: auto;
        z-index: 1000;
        padding: 0;
        margin-bottom: 0;
      }
      .sidebar nav {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
      }
      .sidebar nav a {
        display: block;
        color: #222;
        text-decoration: none;
        font-weight: 500;
        text-transform: uppercase;
        font-family: inherit;
        letter-spacing: 0.01em;
        font-size: 0.85rem;
      }
      .sidebar nav a:hover { 
        text-decoration: underline; 
      }
      .main-content {
        max-width: 100%;
        margin: 0 auto;
        padding: 0;
      }
      .content-wrapper {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 3rem;
        align-items: start;
        margin-top: -3rem;
      }
      .projects-navigation {
        position: fixed;
        top: 2rem;
        left: 2rem;
        width: auto;
        z-index: 999;
        pointer-events: auto;
        padding-left: 120px;
      }
      .projects-nav {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
      }
      .projects-nav-link {
        display: block;
        color: #222;
        text-decoration: none;
        font-weight: 500;
        text-transform: uppercase;
        font-family: inherit;
        letter-spacing: 0.01em;
        font-size: 0.85rem;
      }
      .projects-nav-link:hover {
        text-decoration: underline;
      }
      .project-list {
        display: flex;
        flex-direction: column;
        gap: 2rem;
      }
      .project-preview {
        border-bottom: 1px solid #f0f0f0;
        padding-bottom: 2rem;
      }
      .project-preview h2 {
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
        margin-top: 0;
      }
      .project-description {
        color: #555;
        font-size: 1rem;
        margin: 0.5rem 0 1rem 0;
      }
      .image-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
        gap: 0.75rem;
        margin-top: 1rem;
      }
      .image-grid img,
      .image-grid video {
        width: 100%;
        height: auto;
        border-radius: 8px;
        box-shadow: 0 2px 8px #eee;
      }
      /* Video.js custom styling - hide context menu completely */
      .vjs-contextmenu-ui {
        display: none !important;
      }
      .video-js .vjs-control-bar {
        background-color: rgba(0, 0, 0, 0.5);
      }
      @media (max-width: 900px) {
        .content-wrapper {
          grid-template-columns: 1fr;
          gap: 2rem;
        }
      }
      @media (max-width: 768px) {
        .sidebar {
          display: none !important;
        }
        .container {
          padding: 0.75rem;
          padding-top: 4.75rem !important;
        }
        .main-content h1 {
          font-size: 1.1rem;
          margin-bottom: 0.4rem;
        }
        .content-wrapper {
          grid-template-columns: 1fr;
          gap: 0.75rem;
        }
        .projects-navigation {
          position: fixed;
          top: 4.75rem;
          left: 0;
          width: auto;
          z-index: 999;
          padding: 1rem;
          padding-left: 0.75rem;
        }
        .projects-nav {
          display: flex;
          flex-direction: column;
          gap: 0.5rem;
        }
        .projects-nav-link {
          font-size: 1.5rem;
          font-weight: 700;
        }
        .sub-project-card {
          flex: 0 1 100%;
        }
        .sub-project-card h3 {
          font-size: 0.9rem;
          margin-bottom: 0.2rem;
        }
        .sub-project-card p {
          font-size: 0.7rem;
        }
      }
      @media (max-width: 480px) {
        .container {
          padding: 0.5rem;
          padding-top: 4.75rem !important;
        }
        .main-content h1 {
          font-size: 0.9rem;
          margin-bottom: 0.3rem;
        }
        .content-wrapper {
          gap: 0.5rem;
        }
        .projects-navigation {
          position: fixed;
          top: 4.75rem;
          left: 0;
          width: auto;
          z-index: 999;
          padding: 0.75rem;
          padding-left: 0.5rem;
        }
        .projects-nav {
          display: flex;
          flex-direction: column;
          gap: 0.5rem;
        }
        .projects-nav-link {
          font-size: 1.3rem;
          font-weight: 700;
        }
        .sub-project-card h3 {
          font-size: 0.8rem;
        }
        .sub-project-card p {
          font-size: 0.65rem;
        }
      }
      @media (min-width: 600px) {
        .container {
          padding-left: 140px;
        }
      }
      .language-toggle {
        position: fixed;
        top: 1rem;
        right: 1rem;
        z-index: 10000;
        display: none;
        gap: 0.5rem;
      }
      .language-toggle button {
        background: transparent;
        border: none;
        padding: 0;
        font-size: 0.75rem;
        transition: opacity 0.2s ease;
        opacity: 0.3;
        cursor: pointer;
        font-weight: 500;
        color: #333;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }
      .language-toggle button:hover {
        opacity: 0.6;
      }
      .language-toggle button.active {
        opacity: 1;
      }
      @media (min-width: 769px) {
        .language-toggle {
          display: flex !important;
        }
      }
    </style>
  </head>
  <body>
    <canvas id="letterfall-canvas"></canvas>
    <Logo />
    <Cursor />
    <HamburgerMenu />
    <div class="language-toggle">
      <button class="lang-btn active" data-lang="en">ENG</button>
      <button class="lang-btn" data-lang="et">EST</button>
    </div>
    <div class="container">
      <div class="sidebar">
        <nav>
          <a href="/" data-i18n="nav.home">AVALEHT</a>
          <a href="/studio" data-i18n="nav.studio">STUUDIO</a>
          <a href="/photos" data-i18n="nav.portraits">FOTOD</a>
          <a href="/projects" data-i18n="nav.projects">PROJEKTID</a>
          <a href="/prices" data-i18n="nav.prices">HINNAKIRI</a>
          <a href="/shop" data-i18n="nav.tshirts">E-POOD</a>
          <a href="/contact" data-i18n="nav.contact">KONTAKT</a>
        </nav>
      </div>
      <main class="main-content">
        <div class="content-wrapper">
          {projects.filter(p => p.projects && p.projects.length > 0).map(mainProject => (
            <>
              <div class="projects-navigation">
                <nav class="projects-nav">
                  {mainProject.projects && mainProject.projects.map(sub => (
                    <a href={`/projects/${sub.title.toLowerCase().replace(/\s+/g, '-')}`} class="projects-nav-link">
                      {sub.title}
                    </a>
                  ))}
                </nav>
              </div>
              
              <section class="project-list">
              </section>
            </>
          ))}
        </div>
      </main>
    </div>

    <script is:inline src="/scripts/letterfall.js"></script>
    <script src="https://vjs.zencdn.net/7.20.3/video.js"></script>
    <script is:inline>
      // Setup event listeners first
      document.addEventListener('contextmenu', (e) => {
        const target = e.target;
        if (target.tagName === 'IMG' || target.tagName === 'VIDEO' || target.closest('video') || target.closest('.video-js')) {
          e.preventDefault();
          return false;
        }
      });
      
      // Disable drag and drop on media
      document.addEventListener('dragstart', (e) => {
        if (e.target.tagName === 'IMG' || e.target.tagName === 'VIDEO') {
          e.preventDefault();
          return false;
        }
      });
      
      // Prevent save shortcuts (Cmd+S, Ctrl+S)
      document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key === 's') {
          e.preventDefault();
          return false;
        }
      });
      
      // Prevent copy of images/videos
      document.addEventListener('copy', (e) => {
        if (e.target.tagName === 'IMG' || e.target.tagName === 'VIDEO') {
          e.preventDefault();
          return false;
        }
      });
      
      // Initialize Video.js
      function setupVideojs() {
        if (typeof videojs === 'undefined') {
          setTimeout(setupVideojs, 50);
          return;
        }
        
        const videoElements = document.querySelectorAll('.video-js');
        videoElements.forEach((el) => {
          try {
            if (!el.player) {
              videojs(el, {
                controls: true,
                autoplay: false,
                preload: 'metadata',
                fluid: true,
                aspectRatio: '16:9',
                controlBar: {
                  children: [
                    'playToggle',
                    'progressControl',
                    'volumePanel',
                    'fullscreenToggle'
                  ]
                }
              });
            }
          } catch (e) {
            console.error('Video.js init error:', e);
          }
        });
      }
      
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupVideojs);
      } else {
        setupVideojs();
      }
      
      // Language toggle functionality - listen to header event
      window.addEventListener('languageChange', (e) => {
        const lang = e.detail.language;
        document.documentElement.lang = lang;
        updateTranslations(lang);
      });
      
      // Function to update translations
      function updateTranslations(lang) {
      const translations = {
        'en': {
          'nav.home': 'HOME',
          'nav.portraits': 'PHOTOS',
          'nav.studio': 'STUDIO',
          'nav.projects': 'PROJECTS',
          'nav.prices': 'PRICES',
          'nav.tshirts': 'SHOP',
          'nav.contact': 'CONTACT'
        },
        'et': {
          'nav.home': 'AVALEHT',
          'nav.portraits': 'FOTOD',
          'nav.studio': 'STUUDIO',
          'nav.projects': 'PROJEKTID',
          'nav.prices': 'HINNAKIRI',
          'nav.tshirts': 'E-POOD',
          'nav.contact': 'KONTAKT'
        }
      };        document.querySelectorAll('[data-i18n]').forEach(el => {
          const key = el.getAttribute('data-i18n');
          if (translations[lang] && translations[lang][key]) {
            el.textContent = translations[lang][key];
          }
        });
      }
      
      // Initialize translations on page load
      const savedLang = localStorage.getItem('language') || 'en';
      if (savedLang === 'et') {
        updateTranslations('et');
      }
      
      // Language toggle button functionality
      document.querySelectorAll('.lang-btn').forEach(btn => {
        btn.classList.toggle('active', btn.getAttribute('data-lang') === savedLang);
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const lang = btn.getAttribute('data-lang');
          if (lang) {
            localStorage.setItem('language', lang);
            updateTranslations(lang);
            document.documentElement.lang = lang;
            document.querySelectorAll('.lang-btn').forEach(b => {
              b.classList.toggle('active', b.getAttribute('data-lang') === lang);
            });
          }
        });
      });
    </script>
  </body>
</html>

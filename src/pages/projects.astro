---
import SEO from '../components/SEO.astro';
import Cursor from '../components/Cursor.astro';
import HamburgerMenu from '../components/HamburgerMenu.astro';
import TopNav from '../components/TopNav.astro';
import projects from '../../public/data/projects.json';
import translations from '../data/translations.json';

// Collect all sub-projects with cover images
const subProjects: any[] = [];
projects.forEach((p: any) => {
  if (p.projects && p.projects.length > 0) {
    p.projects.forEach((sub: any) => {
      const slug = sub.title.toLowerCase().replace(/\s+/g, '-');
      let coverImage = '';
      if (sub.media) {
        const imgMedia = sub.media.find((m: any) => m.type === 'image');
        if (imgMedia) coverImage = imgMedia.src;
        else {
          const posterMedia = sub.media.find((m: any) => m.poster);
          if (posterMedia) coverImage = posterMedia.poster;
        }
      } else if (sub.images && sub.images.length > 0) {
        coverImage = sub.images[0];
      }
      subProjects.push({ ...sub, slug, coverImage });
    });
  }
});
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="keywords" content="Holden Laine portfolio, photography projects, content creation, social media content, UGC, portrait photography, fashion photography" />
    <SEO 
      title="Portfolio - Holden Laine Photography Projects & Content"
      titleEt="Portfell - Holden Laine Fotograafia Projektid"
      description="Explore Holden Laine's professional photography portfolio featuring portrait, fashion, editorial, social media content creation, UGC, and commercial projects."
      descriptionEt="Uurige Holden Laine professionaalse fotograafia portfelli, mis sisaldab portreid, moodi, toimetuslikke, sotsiaalmeedia sisutootmis-, UGC ja kommertsprojekte."
      type="website"
    />
    <style is:global>
      body {
        margin: 0;
        font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
        background: #fff;
        color: #222;
        -webkit-user-select: none;
        user-select: none;
      }
      img, video {
        -webkit-user-drag: none;
        user-select: none;
        -webkit-user-select: none;
      }
      #letterfall-canvas {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        pointer-events: none;
      }

      .container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 2rem;
        position: relative;
        z-index: 1;
      }
      .page-title {
        font-size: 1.8rem;
        font-weight: 700;
        margin: 0 0 2rem 0;
        text-transform: uppercase;
        letter-spacing: 0.02em;
      }

      /* 2-column grid for project cards */
      .project-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem;
      }
      .project-card {
        position: relative;
        overflow: hidden;
        border-radius: 4px;
        background: #f0f0f0;
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 0.6s ease, transform 0.6s ease;
      }
      .project-card.visible {
        opacity: 1;
        transform: translateY(0);
      }
      .project-card a {
        display: block;
        text-decoration: none;
        color: inherit;
        position: relative;
      }
      .project-card img {
        width: 100%;
        height: auto;
        display: block;
        transition: transform 0.5s ease;
        aspect-ratio: 4 / 3;
        object-fit: cover;
      }
      .project-card:hover img {
        transform: scale(1.04);
      }
      .project-card-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding: 1.5rem;
        background: linear-gradient(to top, rgba(0,0,0,0.65) 0%, rgba(0,0,0,0.1) 50%, transparent 100%);
        color: #fff;
        pointer-events: none;
        transition: background 0.3s ease;
      }
      .project-card:hover .project-card-overlay {
        background: linear-gradient(to top, rgba(0,0,0,0.75) 0%, rgba(0,0,0,0.15) 50%, transparent 100%);
      }
      .project-card-overlay h3 {
        margin: 0;
        font-size: 1.15rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.03em;
      }
      .project-card-overlay p {
        margin: 0.3rem 0 0;
        font-size: 0.8rem;
        opacity: 0.85;
        letter-spacing: 0.01em;
        line-height: 1.4;
      }
      /* Video-only placeholder when no cover image */
      .project-card-placeholder {
        width: 100%;
        aspect-ratio: 4 / 3;
        background: linear-gradient(135deg, #1a1a1a 0%, #333 100%);
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .project-card-placeholder .play-icon {
        width: 48px;
        height: 48px;
        border: 2px solid rgba(255,255,255,0.5);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: border-color 0.3s ease, transform 0.3s ease;
      }
      .project-card:hover .play-icon {
        border-color: rgba(255,255,255,0.9);
        transform: scale(1.1);
      }
      .play-icon::after {
        content: '';
        display: block;
        width: 0;
        height: 0;
        border-style: solid;
        border-width: 8px 0 8px 14px;
        border-color: transparent transparent transparent rgba(255,255,255,0.7);
        margin-left: 3px;
      }

      @media (max-width: 768px) {
        .container { padding: 1rem; }
        .project-grid {
          grid-template-columns: repeat(2, 1fr);
          gap: 0.75rem;
        }
        .page-title { font-size: 1.4rem; margin-bottom: 1.5rem; }
        .project-card-overlay { padding: 1rem; }
        .project-card-overlay h3 { font-size: 0.9rem; }
        .project-card-overlay p { font-size: 0.7rem; }
      }
      @media (max-width: 480px) {
        .project-grid { grid-template-columns: 1fr; gap: 1rem; }
        .container { padding: 0.75rem; }
      }
    </style>
  </head>
  <body>
    <canvas id="letterfall-canvas"></canvas>
    <TopNav />
    <Cursor />
    <HamburgerMenu />

    <div class="container">
      <h1 class="page-title" data-i18n="nav.projects">Projects</h1>
      <div class="project-grid">
        {subProjects.map((sub: any) => (
          <div class="project-card">
            <a href={`/projects/${sub.slug}`}>
              {sub.coverImage ? (
                <img src={`/images/${sub.coverImage}`} alt={sub.title} loading="lazy" />
              ) : (
                <div class="project-card-placeholder">
                  <div class="play-icon"></div>
                </div>
              )}
              <div class="project-card-overlay">
                <h3>{sub.title}</h3>
                {sub.description && <p>{sub.description}</p>}
              </div>
            </a>
          </div>
        ))}
      </div>
    </div>

    <script is:inline src="/scripts/letterfall.js"></script>
    <script is:inline>
      // Staggered fade-in with IntersectionObserver
      (function() {
        var obs = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry, i) {
            if (entry.isIntersecting) {
              setTimeout(function() { entry.target.classList.add('visible'); }, i * 80);
              obs.unobserve(entry.target);
            }
          });
        }, { threshold: 0.05 });
        document.querySelectorAll('.project-card').forEach(function(el) { obs.observe(el); });

        // Media protection
        document.addEventListener('contextmenu', function(e) {
          if (e.target.tagName === 'IMG' || e.target.tagName === 'VIDEO') e.preventDefault();
        });
        document.addEventListener('dragstart', function(e) {
          if (e.target.tagName === 'IMG' || e.target.tagName === 'VIDEO') e.preventDefault();
        });
      })();
    </script>
    <script is:inline define:vars={{ translations }}>
      var currentLang = localStorage.getItem('language') || 'et';
      function applyTranslations(lang) {
        document.querySelectorAll('[data-i18n]').forEach(function(element) {
          var key = element.getAttribute('data-i18n');
          var keys = key.split('.');
          var value = translations[lang];
          for (var i = 0; i < keys.length; i++) { value = value && value[keys[i]]; }
          if (value) {
            element.tagName === 'TITLE' ? document.title = value : element.textContent = value;
          }
        });
        document.documentElement.lang = lang;
      }
      applyTranslations(currentLang);
      window.addEventListener('languageChange', function(e) {
        applyTranslations(e.detail.language);
      });
    </script>
  </body>
</html>

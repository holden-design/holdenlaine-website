---
import SEO from '../components/SEO.astro';
import Cursor from '../components/Cursor.astro';
import HamburgerMenu from '../components/HamburgerMenu.astro';
import MobileLogo from '../components/MobileLogo.astro';
import Logo from '../components/Logo.astro';
import translations from '../data/translations.json';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO 
      title="Gift Cards"
      titleEt="Kinkekaardid"
      description="Purchase or redeem a gift card for professional photography sessions."
      descriptionEt="Ostke või lunastage kinkekaart professionaalsete fotograafiasessioonide jaoks."
      type="website"
    />
    <style is:global>
      html {
        display: none;
      }
      body {
        margin: 0;
        font-family: "Helvetica Neue", Helvetica;
        background: #fff;
        color: #222;
        display: block;
      }
      #letterfall-canvas {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        pointer-events: none;
      }
      .container {
        max-width: 900px;
        margin: 0 auto;
        padding: 2rem;
      }
      @media (max-width: 768px) {
        .container {
          padding: 1rem 1rem 1rem 1rem;
        }
      }
      .sidebar {
        position: fixed;
        left: 2rem;
        top: 2rem;
        width: auto;
        z-index: 1000;
        padding: 0;
        margin-bottom: 0;
      }
      .sidebar nav {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
      }
      .sidebar nav a {
        display: block;
        color: #222;
        text-decoration: none;
        font-weight: 500;
        text-transform: uppercase;
        font-family: inherit;
        letter-spacing: 0.01em;
        font-size: 0.85rem;
      }
      .sidebar nav a:hover { text-decoration: underline; }
      .main-content {
        max-width: 900px;
        margin: 0 auto;
        padding: 0;
      }
      h1 {
        font-size: 2rem;
        margin-bottom: 2rem;
        margin-top: 0;
      }
      h2 {
        font-size: 1.5rem;
        margin-top: 2rem;
        margin-bottom: 1rem;
      }
      .giftcard-section {
        background: #f9f9f9;
        padding: 2rem;
        border-radius: 8px;
        margin-bottom: 2rem;
      }
      .giftcard-section p {
        color: #666;
        line-height: 1.6;
        margin: 0 0 1rem 0;
      }
      .section-title {
        font-size: 1.2rem;
        font-weight: 600;
        margin-bottom: 1rem;
        text-transform: uppercase;
        letter-spacing: 0.01em;
      }
      .button-group {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
      }
      .btn {
        background: #222;
        color: #fff;
        border: none;
        padding: 0.75rem 1.5rem;
        font-size: 1rem;
        text-transform: uppercase;
        letter-spacing: 0.01em;
        cursor: pointer;
        transition: opacity 0.3s ease;
        font-weight: 500;
      }
      .btn:hover {
        opacity: 0.7;
      }
      .btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
      }
      .form-group {
        margin-bottom: 1rem;
      }
      .form-group label {
        display: block;
        font-weight: 500;
        margin-bottom: 0.5rem;
        text-transform: uppercase;
        font-size: 0.9rem;
        letter-spacing: 0.01em;
      }
      .form-group input,
      .form-group select {
        width: 100%;
        padding: 0.75rem;
        border: 1px solid #ddd;
        border-radius: 4px;
        font-size: 1rem;
        font-family: inherit;
        box-sizing: border-box;
      }
      .form-group input:focus,
      .form-group select:focus {
        outline: none;
        border-color: #222;
        box-shadow: 0 0 0 2px rgba(34, 34, 34, 0.1);
      }
      .form-message {
        margin-top: 1rem;
        padding: 0.75rem;
        border-radius: 4px;
        display: none;
      }
      .form-message.success {
        background: #d4edda;
        color: #155724;
        border: 1px solid #c3e6cb;
        display: block;
      }
      .form-message.error {
        background: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
        display: block;
      }
      .modal {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        z-index: 10001;
        align-items: center;
        justify-content: center;
      }
      .modal.open {
        display: flex;
      }
      .modal-content {
        background: #fff;
        padding: 2rem;
        border-radius: 8px;
        max-width: 400px;
        width: 90%;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
      }
      .modal-content h3 {
        margin-top: 0;
        text-transform: uppercase;
        letter-spacing: 0.01em;
      }
      .close-btn {
        float: right;
        background: none;
        border: none;
        font-size: 1.5rem;
        cursor: pointer;
        color: #999;
      }
      .close-btn:hover {
        color: #333;
      }
      .security-notice {
        background: #e3f2fd;
        border: 1px solid #90caf9;
        border-radius: 4px;
        padding: 1rem;
        margin-bottom: 2rem;
        color: #1565c0;
        font-size: 0.9rem;
      }
      .security-notice strong {
        display: block;
        margin-bottom: 0.5rem;
      }
      @media (max-width: 768px) {
        .sidebar {
          display: none !important;
        }
        .container {
          padding: 1rem;
        }
        .button-group {
          flex-direction: column;
        }
        .btn {
          width: 100%;
        }
      }
      @media (min-width: 600px) {
        .container {
          padding-left: 140px;
        }
      }
    </style>
  </head>
  <body>
    <canvas id="letterfall-canvas"></canvas>
    <Logo />
    <Cursor />
    <HamburgerMenu />
    <div class="container">
      <div class="sidebar">
        <nav>
          <a href="/">HOME</a>
          <a href="/studio">STUDIO</a>
          <a href="/photos">PHOTOS</a>
          <a href="/projects">PROJECTS</a>
          <a href="/prices">PRICES</a>
          <a href="/shop">SHOP</a>
          <a href="/gift-cards">GIFT CARDS</a>
          <a href="/contact">CONTACT</a>
        </nav>
      </div>
      <div class="main-content">
        <h1 data-i18n="giftcard.heading">Gift Cards</h1>

        <div class="security-notice">
          <strong data-i18n="giftcard.securityNotice">🔒 Secure & Private</strong>
          <span data-i18n="giftcard.securityMessage">All payment information is encrypted and processed securely through Stripe. We never store your credit card details.</span>
        </div>

        <!-- Buy Gift Card Section -->
        <div class="giftcard-section">
          <div class="section-title" data-i18n="giftcard.buyTitle">Buy a Gift Card</div>
          <p data-i18n="giftcard.buyDescription">Purchase a gift card to give the gift of professional photography. The recipient can redeem the code on our website.</p>
          <div class="button-group">
            <button class="btn" id="openBuyModal" data-i18n="giftcard.buyNow">Buy Now</button>
          </div>
        </div>

        <!-- Redeem Gift Card Section -->
        <div class="giftcard-section">
          <div class="section-title" data-i18n="giftcard.redeemTitle">Redeem a Gift Card</div>
          <p data-i18n="giftcard.redeemDescription">Have a gift card code? Enter it below to apply it to a booking and proceed to book your session with the gift card value.</p>
          <div class="form-group">
            <label for="redeemCode" data-i18n="giftcard.giftCardCode">Gift Card Code</label>
            <input type="text" id="redeemCode" placeholder="e.g., GC-XXXX-XXXX-XXXX" />
          </div>
          <div id="redeemMessage" class="form-message"></div>
          <button class="btn" id="redeemBtn" data-i18n="giftcard.redeemButton">Verify & Proceed</button>
        </div>
      </div>
    </div>

    <!-- Buy Gift Card Modal -->
    <div class="modal" id="buyModal">
      <div class="modal-content">
        <button class="close-btn" id="closeBuyModal">&times;</button>
        <h3 data-i18n="giftcard.selectAmount">Select Amount</h3>
        <div class="form-group">
          <label for="giftcardAmount" data-i18n="giftcard.amount">Amount</label>
          <select id="giftcardAmount">
            <option value="50">€50</option>
            <option value="100">€100</option>
            <option value="150">€150</option>
            <option value="200">€200</option>
            <option value="250">€250</option>
          </select>
        </div>
        <button class="btn" id="checkoutBtn" style="width: 100%;" data-i18n="giftcard.proceedToPayment">Proceed to Payment</button>
        <div id="buyMessage" class="form-message"></div>
      </div>
    </div>

    <script is:inline src="/scripts/letterfall.js"></script>
    <script define:vars={{ translations }}>
      const t = translations;
      let currentLang = localStorage.getItem('language') || 'en';

      // Language functionality
      function updateLanguage(lang) {
        currentLang = lang;
        localStorage.setItem('language', lang);
        
        document.querySelectorAll('[data-i18n]').forEach(el => {
          const key = el.getAttribute('data-i18n');
          const keys = key.split('.');
          let value = t[lang];
          for (const k of keys) {
            value = value?.[k];
          }
          if (value) el.textContent = value;
        });

        document.querySelectorAll('.lang-btn').forEach(btn => {
          btn.classList.toggle('active', btn.getAttribute('data-lang') === lang);
        });

        document.documentElement.lang = lang;
      }

      document.querySelectorAll('.lang-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const lang = btn.getAttribute('data-lang');
          if (lang) updateLanguage(lang);
        });
      });

      updateLanguage(currentLang);

      // Buy Gift Card Modal
      const buyModal = document.getElementById('buyModal');
      const openBuyModal = document.getElementById('openBuyModal');
      const closeBuyModal = document.getElementById('closeBuyModal');
      const checkoutBtn = document.getElementById('checkoutBtn');
      const giftcardAmount = document.getElementById('giftcardAmount');
      const buyMessage = document.getElementById('buyMessage');

      openBuyModal?.addEventListener('click', () => {
        buyModal.classList.add('open');
        buyMessage.className = 'form-message';
        buyMessage.textContent = '';
      });

      closeBuyModal?.addEventListener('click', () => {
        buyModal.classList.remove('open');
      });

      buyModal?.addEventListener('click', (e) => {
        if (e.target === buyModal) buyModal.classList.remove('open');
      });

      checkoutBtn?.addEventListener('click', async () => {
        const amount = parseInt(giftcardAmount.value);
        checkoutBtn.disabled = true;
        buyMessage.className = 'form-message';
        buyMessage.textContent = t[currentLang]?.contact?.sending || 'Processing...';

        try {
          const response = await fetch('/api/stripe-checkout.json', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              giftCardAmount: amount,
              successUrl: window.location.origin + '/gift-card-success',
              cancelUrl: window.location.origin + '/gift-cards',
            }),
          });

          if (!response.ok) throw new Error('Failed to create checkout session');

          const { sessionId } = await response.json();
          window.location.href = `https://checkout.stripe.com/pay/${sessionId}`;
        } catch (error) {
          console.error('Error:', error);
          buyMessage.className = 'form-message error';
          buyMessage.textContent = t[currentLang]?.contact?.errorMessage || 'Something went wrong.';
          checkoutBtn.disabled = false;
        }
      });

      // Redeem Gift Card
      const redeemBtn = document.getElementById('redeemBtn');
      const redeemCode = document.getElementById('redeemCode');
      const redeemMessage = document.getElementById('redeemMessage');

      redeemBtn?.addEventListener('click', async () => {
        const code = redeemCode.value.trim();
        if (!code) {
          redeemMessage.className = 'form-message error';
          redeemMessage.textContent = t[currentLang]?.giftcard?.enterCode || 'Please enter a gift card code.';
          return;
        }

        redeemBtn.disabled = true;
        redeemMessage.className = 'form-message';
        redeemMessage.textContent = t[currentLang]?.contact?.sending || 'Verifying...';

        try {
          const response = await fetch('/api/redeem-giftcard.json', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ code }),
          });

          const result = await response.json();

          if (!response.ok) {
            redeemMessage.className = 'form-message error';
            redeemMessage.textContent = result.message || t[currentLang]?.giftcard?.invalidCode || 'Invalid gift card code.';
            redeemBtn.disabled = false;
            return;
          }

          // Store the redeemed gift card value in localStorage
          localStorage.setItem('giftcardValue', result.value);
          localStorage.setItem('giftcardCode', code);

          redeemMessage.className = 'form-message success';
          redeemMessage.textContent = t[currentLang]?.giftcard?.redeemSuccess || 'Gift card verified! Redirecting to booking...';

          // Redirect to contact page after 2 seconds
          setTimeout(() => {
            window.location.href = '/contact';
          }, 2000);
        } catch (error) {
          console.error('Error:', error);
          redeemMessage.className = 'form-message error';
          redeemMessage.textContent = t[currentLang]?.contact?.errorMessage || 'Something went wrong.';
          redeemBtn.disabled = false;
        }
      });
    </script>
  </body>
</html>

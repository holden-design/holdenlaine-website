---
import SEO from '../components/SEO.astro';
import Logo from '../components/Logo.astro';
import HamburgerMenu from '../components/HamburgerMenu.astro';
import translations from '../data/translations.json';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="keywords" content="Holden Laine, photography, fotograafia, foto, content creation, social media, sotsiaalmeedia, UGC, portrait, fashion, editorial, commercial, photographer, fotograaf" />
    <SEO 
      title="Holden Laine - Professional Photography, Content Creation & Social Media"
      titleEt="Holden Laine - Professionaalne Fotograafia, Sotsiaalmeedia Sisu ja Fotograafia Teenused"
      description="Holden Laine Photography - Professional photographer specializing in portrait, fashion, editorial, commercial content, UGC, and social media photography. Content creation and visual storytelling expert."
      descriptionEt="Holden Laine Fotograafia - Professionaalne fotograaf, kes spetsialiseerub portreid, moefotograafiat, toimetuslikke projekte, kommertsfotos, UGC ja sotsiaalmeedia sisu loomises. Visuaalse loomekirjutuse ja sisutootmise spetsialist."
      type="profile"
      image="/images/og-image.jpg"
    />
    <style>
      html,body{height:100%;overflow:hidden}
      body{margin:0;font-family:"Helvetica Neue", Helvetica, Arial, sans-serif;display:flex;align-items:center;justify-content:center;background:#fff;color:#111;cursor:none;position:relative}
      * {cursor:none !important}
      #letterfall-canvas {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        pointer-events: none;
      }
      .custom-cursor {
        width: 20px;
        height: 20px;
        border: 2px solid #111;
        border-radius: 50%;
        position: fixed;
        pointer-events: none;
        z-index: 10001;
        transform: translate(-50%, -50%);
        transition: width 0.2s ease, height 0.2s ease, border-color 0.2s ease;
      }
      .custom-cursor.hover {
        width: 40px;
        height: 40px;
        border-color: #999;
      }
      nav{display:flex;flex-direction:column;gap:0.75rem;text-align:left}
      nav a{color:inherit;text-decoration:none;font-weight:500;text-transform:lowercase;letter-spacing:.02em;padding:0;font-size:1rem}
      .wrap{
        position:fixed;
        left:50%;
        top:50%;
        transform:translate(-50%, -50%);
        z-index:1000;
        padding:0;
        width:80%;
        max-width:800px;
      }
      nav{
        display:block;
        text-align:left;
        position:relative;
        line-height:1.2;
        min-height: 20rem;
      }
      nav a{
        display:inline-block;
        font-size:clamp(1.7rem, 4.25vw, 3.4rem);
        font-weight:700;
        text-transform:uppercase;
        letter-spacing:0.01em;
        margin:0.05rem 0;
        position:relative;
        transition: opacity 0.3s ease, transform 0.3s ease;
        white-space: nowrap;
      }
      nav a:hover{
        opacity: 0.5;
        transform: translateX(10px);
      }
      .logo-container {
        position: fixed;
        top: 1rem;
        left: 1rem;
        z-index: 10000;
        width: 90px;
        height: 90px;
      }
      .logo-container img {
        width: 100%;
        height: 100%;
        object-fit: contain;
      }
      nav a:nth-child(1) { margin-left: 0; }
      nav a:nth-child(2) { margin-left: 12%; }
      nav a:nth-child(3) { margin-left: 24%; }
      nav a:nth-child(4) { margin-left: 8%; }
      nav a:nth-child(5) { margin-left: 20%; }
      nav a:nth-child(6) { margin-left: 3%; }
      nav a:nth-child(7) { position: absolute; bottom: 3.5rem; margin-left: 0; left: 25%; }
      
      @media (max-width: 768px) {
        .wrap {
          width: 90%;
          padding: 1rem;
          top: 50%;
          max-width: none;
        }
        nav {
          display: flex;
          flex-direction: column;
          gap: 0.5rem;
          text-align: left;
          min-height: auto;
        }
        nav a {
          font-size: clamp(1.5rem, 8vw, 2.5rem);
          margin: 0.1rem 0;
          display: block;
        }
        nav a:nth-child(1),
        nav a:nth-child(2),
        nav a:nth-child(3),
        nav a:nth-child(4),
        nav a:nth-child(5),
        nav a:nth-child(6),
        nav a:nth-child(7) {
          margin-left: 0;
          position: static;
          left: auto;
          bottom: auto;
        }
        .custom-cursor {
          display: none;
        }
        body, * {
          cursor: auto !important;
        }
      }
      .lang-toggle {
        position: fixed;
        top: 1rem;
        right: 1rem;
        z-index: 10000;
        display: none;
        gap: 0.5rem;
      }
      .lang-toggle button {
        background: transparent;
        border: none;
        padding: 0;
        font-size: 0.75rem;
        transition: opacity 0.2s ease;
        opacity: 0.3;
        cursor: pointer;
        font-weight: 500;
        color: #333;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }
      .lang-toggle button:hover {
        opacity: 0.6;
      }
      .lang-toggle button.active {
        opacity: 1;
      }
      @media (min-width: 769px) {
        .lang-toggle {
          display: flex !important;
        }
      }
    </style>
  </head>
  <body>
    <canvas id="letterfall-canvas"></canvas>
    <Logo />
    <div class="custom-cursor"></div>
    <HamburgerMenu />
    <div class="lang-toggle">
      <button class="lang-btn active" data-lang="en">ENG</button>
      <button class="lang-btn" data-lang="et">EST</button>
    </div>
    <div class="wrap">
      <nav id="nav">
        <a href="/" data-i18n="nav.home">HOME</a>
        <a href="/studio" data-i18n="nav.studio">STUDIO</a>
        <a href="/photos" data-i18n="nav.portraits">PHOTOS</a>
        <a href="/projects" data-i18n="nav.projects">PROJECTS</a>
        <a href="/prices" data-i18n="nav.prices">PRICES</a>
        <a href="/shop" data-i18n="nav.tshirts">SHOP</a>
        <a href="/contact" data-i18n="nav.contact">CONTACT</a>
      </nav>
    </div>
    <script define:vars={{ translations }}>
      const t = translations;
      let currentLang = localStorage.getItem('language') || 'en';

      // Update page text based on language
      function updateLanguage(lang) {
        currentLang = lang;
        localStorage.setItem('language', lang);
        
        // Update all elements with data-i18n attribute
        document.querySelectorAll('[data-i18n]').forEach(el => {
          const key = el.getAttribute('data-i18n');
          const keys = key.split('.');
          let value = t[lang];
          for (const k of keys) {
            value = value[k];
          }
          if (value) {
            el.textContent = value;
          }
        });

        // Update HTML lang attribute
        document.documentElement.lang = lang;
      }

      // Listen for language change events from header
      window.addEventListener('languageChange', (e) => {
        updateLanguage(e.detail.language);
      });

      // Initialize with saved language
      updateLanguage(currentLang);

      // Letterfall animation
      const canvas = document.getElementById('letterfall-canvas');
      const ctx = canvas.getContext('2d');
      
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
      
      const letters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@#$%&*+=?!';
      const fontSize = 16;
      const chars = [];
      
      // Create scattered characters with slow movement
      const numChars = 80;
      for (let i = 0; i < numChars; i++) {
        chars.push({
          x: Math.random() * canvas.width,
          y: Math.random() * canvas.height,
          char: letters[Math.floor(Math.random() * letters.length)],
          opacity: Math.random() * 0.2 + 0.3,
          dx: (Math.random() - 0.5) * 1.5,
          dy: (Math.random() - 0.5) * 1.5
        });
      }
      
      function draw() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        ctx.font = `${fontSize}px "Helvetica Neue", Helvetica, Arial, sans-serif`;
        
        for (let char of chars) {
          ctx.fillStyle = `rgba(40, 40, 40, ${char.opacity})`;
          ctx.fillText(char.char, char.x, char.y);
          
          // Slow drift movement
          char.x += char.dx;
          char.y += char.dy;
          
          // Wrap around screen edges
          if (char.x < -20) char.x = canvas.width + 20;
          if (char.x > canvas.width + 20) char.x = -20;
          if (char.y < -20) char.y = canvas.height + 20;
          if (char.y > canvas.height + 20) char.y = -20;
        }
      }
      
      let animationFrame;
      function animate() {
        draw();
        animationFrame = requestAnimationFrame(animate);
      }
      animate();
      
      window.addEventListener('resize', () => {
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
        // Reposition characters on resize
        chars.forEach(char => {
          char.x = Math.random() * canvas.width;
          char.y = Math.random() * canvas.height;
        });
      });
      
      window.addEventListener('resize', () => {
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
      });

      // Custom cursor movement
      const cursor = document.querySelector('.custom-cursor');
      document.addEventListener('mousemove', (e) => {
        if (cursor) {
          cursor.style.left = e.clientX + 'px';
          cursor.style.top = e.clientY + 'px';
        }
      });
      
      document.addEventListener('mouseover', (e) => {
        if (cursor && e.target instanceof Element && (e.target.tagName === 'A' || e.target.closest('a'))) {
          cursor.classList.add('hover');
        }
      });
      
      document.addEventListener('mouseout', (e) => {
        if (cursor && e.target instanceof Element && (e.target.tagName === 'A' || e.target.closest('a'))) {
          cursor.classList.remove('hover');
        }
      });

      // Language toggle
      const langButtons = document.querySelectorAll('.lang-toggle .lang-btn');
      langButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          langButtons.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          const lang = btn.getAttribute('data-lang');
          if (lang) {
            localStorage.setItem('language', lang);
            window.dispatchEvent(new CustomEvent('languageChange', { detail: { language: lang } }));
          }
        });
      });
    </script>
  </body>
</html>

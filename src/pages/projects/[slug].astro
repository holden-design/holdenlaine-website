---
import SEO from '../../components/SEO.astro';
import Cursor from '../../components/Cursor.astro';
import HamburgerMenu from '../../components/HamburgerMenu.astro';
import MobileLogo from '../../components/MobileLogo.astro';
import Logo from '../../components/Logo.astro';
import projects from '../../../public/data/projects.json';

export const prerender = true;

export async function getStaticPaths() {
  const projectsWithSubs = projects.filter((p: any) => p.projects && p.projects.length > 0);
  const allSubs = projectsWithSubs.flatMap((p: any) => 
    p.projects.map((sub: any) => ({
      params: { slug: sub.title.toLowerCase().replace(/\s+/g, '-') },
      props: { sub, mainProjectTitle: p.title }
    }))
  );
  return allSubs;
}

const { slug } = Astro.params;
let sub = Astro.props.sub;

if (!sub) {
  const projectsWithSubs = projects.filter((p: any) => p.projects && p.projects.length > 0);
  for (const mainProject of projectsWithSubs) {
    const found = mainProject?.projects?.find((p: any) => 
      p.title.toLowerCase().replace(/\s+/g, '-') === slug
    );
    if (found) {
      sub = found;
      break;
    }
  }
}

// Get first image as OG image
const ogImage = sub?.media?.find((item: any) => item.type !== 'video')?.src || 
                sub?.images?.[0] || 
                '/images/og-image.jpg';

// Estonian translations for project descriptions
const projectTranslations: {[key: string]: {en: string, et: string}} = {
  'tõnise-talu': {
    en: 'A video project from Muhu island showcasing Estonian summer beauty',
    et: 'Videoprojekt Muhu saarelt, mis näitab Eesti suve ilu'
  },
  'ugc': {
    en: 'User Generated Content creation and collaborations',
    et: 'Kasutaja loodud sisu loomine ja koostööd'
  },
  'peugeot': {
    en: 'Professional social media content creation for Peugeot',
    et: 'Professionaalne sotsiaalmeedia sisutootmine Peugeot\'ile'
  },
  'lexus': {
    en: 'Automotive photography for Lexus campaigns',
    et: 'Autofotograafia Lexuse kampaaniatele'
  },
  'roseni-maja': {
    en: 'Architecture and interior photography of Roseni maja in Tallinn',
    et: 'Roseni maja arhitektuuri ja sisustuse fotograafia Tallinnas'
  }
};

const translations = projectTranslations[slug] || { en: sub?.description || '', et: sub?.description || '' };
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO 
      title={sub?.title || 'Project'}
      titleEt={sub?.title || 'Project'}
      description={sub?.description || ''}
      descriptionEt={sub?.description || ''}
      image={sub?.images?.[0] || '/images/og-image.jpg'}
      type="article"
    />
    <style is:global>
      body {
        margin: 0;
        font-family: "Helvetica Neue", Helvetica;
        background: #fff;
        color: #222;
        -webkit-user-select: none;
        user-select: none;
      }
      img, video {
        -webkit-user-drag: none;
        user-select: none;
      }
      #letterfall-canvas {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        pointer-events: none;
      }
    </style>
    <style>
      .container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 2rem;
        padding-left: 160px;
        position: relative;
        z-index: 1;
      }
      .header {
        margin-bottom: 2rem;
      }
      .back-link {
        color: #222;
        text-decoration: none;
        font-size: 0.85rem;
        margin-bottom: 1rem;
        display: inline-block;
        text-transform: uppercase;
        letter-spacing: 0.01em;
      }
      .back-link:hover {
        text-decoration: underline;
      }
      h1 {
        font-size: 2rem;
        font-weight: 700;
        margin: 0;
        text-transform: uppercase;
        letter-spacing: 0.02em;
      }
      .description {
        color: #666;
        font-size: 0.85rem;
        margin-top: 0.3rem;
        text-transform: uppercase;
        letter-spacing: 0.01em;
      }
      .gallery-wrapper {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
        align-items: start;
      }
      .left-column {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        max-width: 500px;
      }
      .main-image {
        width: 100%;
        height: auto;
        display: block;
        object-fit: contain;
        max-width: 600px;
        cursor: pointer;
      }
      .left-column .main-image:first-of-type {
        max-width: 100%;
        margin-bottom: 1rem;
      }
      .secondary-images {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }
      .secondary-images img,
      .secondary-images video {
        width: 100%;
        height: auto;
        display: block;
        object-fit: contain;
        max-width: 500px;
      }
      .sidebar {
        position: fixed;
        left: 2rem;
        top: 2rem;
        z-index: 100;
      }
      .sidebar nav {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
      }
      .sidebar nav a {
        color: #222;
        text-decoration: none;
        font-size: 0.75rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.01em;
      }
      .sidebar nav a:hover {
        text-decoration: underline;
      }
      .lang-toggle {
        position: fixed;
        top: 1rem;
        right: 1rem;
        z-index: 100;
        display: flex;
        gap: 0.5rem;
      }
      .lang-toggle button {
        background: transparent;
        border: none;
        padding: 0;
        font-size: 0.7rem;
        opacity: 0.3;
        cursor: pointer;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        transition: opacity 0.2s ease;
      }
      .lang-toggle button:hover {
        opacity: 0.6;
      }
      .lang-toggle button.active {
        opacity: 1;
      }
      @media (max-width: 1200px) {
        .gallery-wrapper {
          grid-template-columns: 1fr;
        }
      }
      @media (max-width: 768px) {
        .container {
          padding: 1rem;
          padding-left: 1rem;
        }
        .sidebar {
          display: none;
        }
        .gallery-wrapper {
          grid-template-columns: 1fr;
        }
        h1 {
          font-size: 1.5rem;
        }
      }
    </style>
  </head>
  <body>
    <canvas id="letterfall-canvas"></canvas>
    <Cursor />
    <HamburgerMenu />
    <MobileLogo />
    
    <div class="sidebar">
      <nav>
        <a href="/">HOME</a>
        <a href="/photos">PHOTOS</a>
        <a href="/studio">STUDIO</a>
        <a href="/projects">PROJECTS</a>
        <a href="/prices">PRICES</a>
        <a href="/shop">SHOP</a>
        <a href="/contact">CONTACT</a>
      </nav>
    </div>

    <div class="lang-toggle">
      <button class="lang-btn active" data-lang="en">EN</button>
      <button class="lang-btn" data-lang="et">ET</button>
    </div>

    <div class="container">
      <a href="/projects" class="back-link">← BACK</a>
      
      <div class="header">
        <h1>{sub?.title}</h1>
        {sub?.description && <p class="description">{sub.description}</p>}
      </div>

      <div class="gallery-wrapper">
        <div class="left-column">
          {sub?.images && sub.images.length > 0 && (
            <img src={`/images/${sub.images[0]}`} alt={sub.title} class="main-image" />
          )}
          {sub?.media && sub.media.length > 0 && sub.media[0]?.type === 'video' && (
            <video controls preload="metadata" poster={sub.media[0].poster ? `/images/${sub.media[0].poster}` : undefined} class="main-image">
              <source src={`/images/${sub.media[0].src}`} type="video/mp4" />
              Your browser does not support the video tag.
            </video>
          )}
          {sub?.media && sub.media.length > 0 && sub.media[0]?.type === 'image' && (
            <img src={`/images/${sub.media[0].src}`} alt={sub.title} class="main-image" />
          )}
          
          {sub?.images && sub.images.length > 2 && (
            <div class="secondary-images">
              {sub.images.slice(1, Math.ceil(sub.images.length / 2) + 1).map((img: string) => (
                <img src={`/images/${img}`} alt={sub.title} loading="lazy" />
              ))}
            </div>
          )}
          {sub?.media && sub.media.filter((item: any) => item.type === 'image').length > 0 && (
            <div class="secondary-images">
              {sub.media.filter((item: any) => item.type === 'image').slice(0, Math.ceil(sub.media.filter((item: any) => item.type === 'image').length / 2)).map((item: any) => (
                <img src={`/images/${item.src}`} alt={sub.title} loading="lazy" />
              ))}
            </div>
          )}
        </div>

        <div>
          {sub?.images && sub.images.length > Math.ceil(sub.images.length / 2) + 1 && (
            <div class="secondary-images">
              {sub.images.slice(Math.ceil(sub.images.length / 2) + 1).map((img: string) => (
                <img src={`/images/${img}`} alt={sub.title} loading="lazy" />
              ))}
            </div>
          )}
          {sub?.media && sub.media.filter((item: any) => item.type === 'image').length > 0 && (
            <div class="secondary-images">
              {sub.media.filter((item: any) => item.type === 'image').slice(Math.ceil(sub.media.filter((item: any) => item.type === 'image').length / 2)).map((item: any) => (
                <img src={`/images/${item.src}`} alt={sub.title} loading="lazy" />
              ))}
            </div>
          )}
          {sub?.media && sub.media.filter((item: any) => item.type === 'video').length > 1 && (
            <div class="secondary-images">
              {sub.media.filter((item: any) => item.type === 'video').slice(1).map((item: any) => (
                <video controls preload="metadata" poster={item.poster ? `/images/${item.poster}` : undefined}>
                  <source src={`/images/${item.src}`} type="video/mp4" />
                </video>
              ))}
            </div>
          )}
        </div>
      </div>
    </div>

    <script is:inline src="/scripts/letterfall.js"></script>
    <script is:inline>
      // Video click to play/pause
      setTimeout(() => {
        document.querySelectorAll('video').forEach(video => {
          video.onclick = function(e) {
            e.stopPropagation();
            this.paused ? this.play() : this.pause();
          };
        });
      }, 50);

      // Language toggle
      const savedLang = localStorage.getItem('language') || 'en';
      document.documentElement.lang = savedLang;
      document.querySelectorAll('.lang-btn').forEach(b => {
        b.classList.toggle('active', b.getAttribute('data-lang') === savedLang);
      });

      document.querySelectorAll('.lang-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const lang = btn.getAttribute('data-lang');
          localStorage.setItem('language', lang);
          document.documentElement.lang = lang;
          document.querySelectorAll('.lang-btn').forEach(b => {
            b.classList.toggle('active', b.getAttribute('data-lang') === lang);
          });
        });
      });

      // Prevent right-click and dragging on media
      document.addEventListener('contextmenu', (e) => {
        if (e.target.tagName === 'VIDEO' || e.target.tagName === 'IMG') {
          e.preventDefault();
        }
      });

      document.addEventListener('dragstart', (e) => {
        if (e.target.tagName === 'VIDEO' || e.target.tagName === 'IMG') {
          e.preventDefault();
        }
      });
    </script>
  </body>
</html>

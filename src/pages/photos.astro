---
import SEO from '../components/SEO.astro';
import Cursor from '../components/Cursor.astro';
import HamburgerMenu from '../components/HamburgerMenu.astro';
import TopNav from '../components/TopNav.astro';
import translations from '../data/translations.json';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO 
      title="Photography Gallery"
      titleEt="Fotogalerii"
      description="Browse my photography collections including fashion, portrait, editorial, and street photography galleries."
      descriptionEt="Vaadake minu fotograafia kollektsioone, sealhulgas mood, portree, toimetuslikke ja tänavafotograafia galeriisid."
      type="website"
    />
    <style is:global>
      body {
        margin: 0;
        font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
        background: #fff;
        color: #222;
      }
      #letterfall-canvas {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        pointer-events: none;
      }
      .container {
        width: 100%;
        min-height: 100vh;
        position: relative;
        z-index: 1;
      }
      .main-content {
        max-width: 1100px;
        margin: 0 auto;
        padding: 2rem;
        padding-top: 2rem;
        box-sizing: border-box;
      }
      .photo-categories {
        columns: 3;
        column-gap: 1.5rem;
        margin-top: 2rem;
      }
      .category-card {
        break-inside: avoid;
        position: relative;
        overflow: hidden;
        border-radius: 4px;
        background: #f5f5f5;
        margin-bottom: 1.5rem;
      }
      .category-card a {
        display: block;
        width: 100%;
        position: relative;
      }
      .category-card img {
        width: 100%;
        height: auto;
        display: block;
        object-fit: cover;
        transition: transform 0.4s ease;
      }
      .category-card:hover img {
        transform: scale(1.05);
      }
      .category-label {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 1.25rem 1rem;
        background: linear-gradient(to top, rgba(0,0,0,0.65), transparent);
        color: white;
        font-size: 1rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        pointer-events: none;
        transition: opacity 0.3s ease;
      }
      .category-card:hover .category-label {
        opacity: 0.85;
      }

      /* Staggered fade-in */
      .category-card {
        opacity: 0;
        transform: translateY(20px);
        animation: fadeInUp 0.6s ease forwards;
      }
      .category-card:nth-child(1) { animation-delay: 0.1s; }
      .category-card:nth-child(2) { animation-delay: 0.25s; }
      .category-card:nth-child(3) { animation-delay: 0.4s; }

      @keyframes fadeInUp {
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @media (max-width: 768px) {
        .photo-categories {
          columns: 2;
          column-gap: 1rem;
        }
        .category-card {
          margin-bottom: 1rem;
        }
        .main-content {
          padding: 1rem;
        }
      }
      @media (max-width: 480px) {
        .photo-categories {
          columns: 1;
        }
        .main-content {
          padding: 0.75rem;
        }
      }
    </style>
  </head>
  <body>
    <canvas id="letterfall-canvas"></canvas>
    <TopNav />
    <Cursor />
    <HamburgerMenu />
    
    <div class="container">
      <div class="main-content">
        <div class="photo-categories">
          <div class="category-card">
            <a href="/photos/portrait">
              <img src="/images/Chew/_F5A0975.jpg" alt="Portrait Photography" loading="lazy" />
              <div class="category-label" data-i18n="photos.portrait">portrait</div>
            </a>
          </div>
          
          <div class="category-card">
            <a href="/photos/fashion">
              <img src="/images/Fashion product photography/sonyaa.jpg" alt="Fashion Photography" loading="lazy" />
              <div class="category-label" data-i18n="photos.fashion">fashion</div>
            </a>
          </div>
          
          <div class="category-card">
            <a href="/photos/street">
              <img src="/images/Street/_F5A9263.jpg" alt="Street Photography" loading="lazy" />
              <div class="category-label" data-i18n="photos.street">street</div>
            </a>
          </div>
        </div>
      </div>
    </div>

    <script is:inline src="/scripts/letterfall.js"></script>
    <script is:inline define:vars={{ translations }}>
      const currentLang = localStorage.getItem('language') || 'et';
      
      function applyTranslations(lang) {
        document.querySelectorAll('[data-i18n]').forEach(element => {
          const key = element.getAttribute('data-i18n');
          const keys = key.split('.');
          let value = translations[lang];
          for (const k of keys) { value = value?.[k]; }
          if (value) {
            element.tagName === 'TITLE' ? document.title = value : element.textContent = value;
          }
        });
        document.documentElement.lang = lang;
      }
      
      applyTranslations(currentLang);
      
      window.addEventListener('languageChange', (e) => {
        applyTranslations(e.detail.language);
      });
    </script>
  </body>
</html>

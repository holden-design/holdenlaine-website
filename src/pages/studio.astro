---
import SEO from '../components/SEO.astro';
import Cursor from '../components/Cursor.astro';
import HamburgerMenu from '../components/HamburgerMenu.astro';
import MobileLogo from '../components/MobileLogo.astro';
import Logo from '../components/Logo.astro';
import translations from '../data/translations.json';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO 
      title="Studio"
      titleEt="Stuudio"
      description="Welcome to Holden Laine's photography studio. Experience professional photography services in a creative space."
      descriptionEt="Tere tulemast Holden Laine'i fotograafiastuudiosse. Koges professionaalset fotograafiateeninust loomingulises keskkonnas."
      type="website"
    />
    <style is:global>
      body {
        margin: 0;
        font-family: "Helvetica Neue", Helvetica;
        background: #fff;
        color: #222;
        display: block;
        -webkit-user-select: none;
        user-select: none;
      }
      img {
        -webkit-user-drag: none;
        user-select: none;
        -webkit-user-select: none;
      }
      #letterfall-canvas {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        pointer-events: none;
      }
      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem;
        position: relative;
        z-index: 1;
      }
      @media (max-width: 768px) {
        .container {
          padding: 0;
          padding-top: 4.75rem !important;
        }
        .main-content {
          margin-left: 0;
        }
        .main-content h1 {
          font-size: 1.1rem;
          margin-bottom: 0.4rem;
        }
        .main-content p {
          font-size: 0.8rem;
          line-height: 1.4;
        }
        .studio-header {
          margin-bottom: 0.75rem;
          margin-top: 0;
          margin-left: -70px;
        }
        .studio-content {
          margin-left: -70px;
        }
      }
      @media (max-width: 480px) {
        .container {
          padding: 0.5rem;
          padding-top: 4.75rem !important;
        }
        .main-content h1 {
          font-size: 0.9rem;
          margin-bottom: 0.3rem;
        }
        .main-content p {
          font-size: 0.7rem;
        }
      }
      .sidebar {
        position: fixed;
        left: 2rem;
        top: 2rem;
        width: auto;
        z-index: 1000;
        padding: 0;
        margin-bottom: 0;
      }
      .sidebar nav {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
      }
      .sidebar nav a {
        display: block;
        color: #222;
        text-decoration: none;
        font-weight: 500;
        text-transform: uppercase;
        font-family: inherit;
        letter-spacing: 0.01em;
        font-size: 0.85rem;
      }
      .sidebar nav a:hover { 
        text-decoration: underline; 
      }
      .main-content {
        max-width: 100%;
        margin: 0 auto;
        padding: 0;
      }
      .studio-header {
        margin-bottom: 1.5rem;
        margin-top: 0;
        margin-left: 50px;
      }
      .studio-header h1 {
        font-size: 1.75rem;
        margin: 0 0 0.5rem 0;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.02em;
      }
      .studio-header p {
        color: #555;
        font-size: 0.9rem;
        margin: 0;
        text-transform: uppercase;
        letter-spacing: 0.01em;
      }
      .studio-content {
        margin-bottom: 3rem;
        line-height: 1.8;
        margin-left: 50px;
      }
      }
      .studio-content p {
        color: #555;
        font-size: 0.95rem;
        margin-bottom: 1.5rem;
      }
      .studio-section {
        margin-bottom: 2.5rem;
      }
      .studio-section h2 {
        font-size: 1.2rem;
        margin-bottom: 1rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.01em;
      }
      .studio-section ul {
        list-style: none;
        padding: 0;
        margin: 0;
      }
      .studio-section li {
        color: #555;
        font-size: 0.9rem;
        margin-bottom: 0.75rem;
        padding-left: 1.5rem;
        position: relative;
      }
      .studio-section li:before {
        content: "—";
        position: absolute;
        left: 0;
      }
      .language-toggle {
        position: fixed;
        top: 1rem;
        right: 1rem;
        z-index: 10000;
        display: none;
        gap: 0.5rem;
      }
      .language-toggle button {
        background: transparent;
        border: none;
        padding: 0;
        font-size: 0.75rem;
        transition: opacity 0.2s ease;
        opacity: 0.3;
        cursor: pointer;
        font-weight: 500;
        color: #333;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }
      .language-toggle button:hover {
        opacity: 0.6;
      }
      .language-toggle button.active {
        opacity: 1;
      }
      @media (min-width: 769px) {
        .language-toggle {
          display: flex !important;
        }
      }
      @media (max-width: 900px) {
        .container {
          padding: 1.5rem;
        }
      }
      @media (max-width: 768px) {
        .sidebar {
          display: none !important;
        }
        .container {
          padding: 1rem;
          padding-top: 4.75rem !important;
          max-width: 100%;
          margin: 0;
        }
        .studio-header {
          margin-left: 10px;
        }
        .studio-content {
          margin-left: 10px;
        }
        .studio-header h1 {
          font-size: 1.3rem;
        }
        .language-toggle {
          top: 0.5rem;
          right: 0.5rem;
        }
      }
      @media (max-width: 480px) {
        .sidebar nav a {
          font-size: 0.65rem;
        }
        .container {
          padding: 0.75rem;
          padding-top: 4.75rem !important;
        }
        .studio-header h1 {
          font-size: 1.1rem;
          margin-bottom: 1rem;
        }
      }
    </style>
  </head>
  <body>
    <canvas id="letterfall-canvas"></canvas>
    <Logo />
    <Cursor />
    <HamburgerMenu />
    <div class="language-toggle">
      <button class="lang-btn active" data-lang="en">ENG</button>
      <button class="lang-btn" data-lang="et">EST</button>
    </div>
    <div class="container">
      <div class="sidebar">
        <nav>
          <a href="/" data-i18n="nav.home">HOME</a>
          <a href="/studio" data-i18n="nav.studio">STUDIO</a>
          <a href="/photos" data-i18n="nav.portraits">PHOTOS</a>
          <a href="/projects" data-i18n="nav.projects">PROJECTS</a>
          <a href="/prices" data-i18n="nav.prices">PRICES</a>
          <a href="/shop" data-i18n="nav.tshirts">SHOP</a>
          <a href="/contact" data-i18n="nav.contact">CONTACT</a>
        </nav>
      </div>
      <div class="main-content">
        <div class="studio-header">
          <h1 data-i18n="studio.heading">Studio</h1>
        </div>

        <div class="studio-content">
          <p style="font-size: 1rem; color: #555; letter-spacing: -0.02em;" data-i18n="studio.picturesComingSoon">PICTURES TO BE ADDED SOON, THANK YOU</p>
        </div>
      </div>
    </div>

    <script is:inline src="/scripts/letterfall.js"></script>
    <script is:inline define:vars={{ translations }}>
      const currentLang = localStorage.getItem('language') || 'et';
      
      function applyTranslations(lang) {
        document.querySelectorAll('[data-i18n]').forEach(element => {
          const key = element.getAttribute('data-i18n');
          const keys = key.split('.');
          let value = translations[lang];
          
          for (const k of keys) {
            value = value?.[k];
          }
          
          if (value) {
            if (element.tagName === 'INPUT' || element.tagName === 'TEXTAREA') {
              element.placeholder = value;
            } else if (element.tagName === 'OPTION') {
              element.textContent = value;
            } else if (element.tagName === 'TITLE') {
              document.title = value;
            } else {
              element.textContent = value;
            }
          }
        });
        
        document.documentElement.lang = lang;
      }
      
      applyTranslations(currentLang);
      
      // Language toggle functionality
      document.querySelectorAll('.lang-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const lang = btn.getAttribute('data-lang');
          if (lang) {
            localStorage.setItem('language', lang);
            applyTranslations(lang);
            document.querySelectorAll('.lang-btn').forEach(b => {
              b.classList.toggle('active', b.getAttribute('data-lang') === lang);
            });
          }
        });
      });
      
      // Listen for language change events from header
      window.addEventListener('languageChange', (e) => {
        applyTranslations(e.detail.language);
      });
    </script>
  </body>
</html>

---
import SEO from '../components/SEO.astro';
import Cursor from '../components/Cursor.astro';
import HamburgerMenu from '../components/HamburgerMenu.astro';
import MobileLogo from '../components/MobileLogo.astro';
import Logo from '../components/Logo.astro';
import translations from '../data/translations.json';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="keywords" content="Holden Laine pricing, photography rates, fotograafia hinnad, content creation pricing, social media content rates, UGC rates, photo session prices" />
    <SEO 
      title="Pricing - Holden Laine Photography Services"
      titleEt="Hinnakiri - Holden Laine Fotograafia Teenused"
      description="Photography services pricing by Holden Laine for portraits, fashion shoots, editorial projects, social media content creation, UGC, and commercial work."
      descriptionEt="Holden Laine fotograafia teenuste hinnad portreede, moofotode, toimetuslike projektide, sotsiaalmeedia sisutootmise, UGC ja kommertsprojektide jaoks."
      type="website"
    />
    <style is:global>
      body {
        margin: 0;
        font-family: "Helvetica Neue", Helvetica;
        background: #fff;
        color: #222;
        display: block;
      }
      #letterfall-canvas {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        pointer-events: none;
      }
      
      @media (max-width: 768px) {
        .sidebar {
          display: none !important;
        }
        .container {
          padding: 0.75rem !important;
          padding-top: 4.75rem !important;
        }
        h1 {
          font-size: 1.1rem;
          margin-bottom: 0.75rem;
        }
        .price-section {
          margin-bottom: 1.5rem;
        }
        .price-section h2 {
          font-size: 1rem;
          margin-bottom: 0.5rem;
        }
        .price-item {
          margin-bottom: 0.75rem;
        }
        .price-item p {
          font-size: 0.75rem;
        }
      }
      @media (max-width: 480px) {
        .container {
          padding: 0.5rem !important;
          padding-top: 4.75rem !important;
        }
        h1 {
          font-size: 0.9rem;
          margin-bottom: 0.5rem;
        }
        .price-section {
          margin-bottom: 1rem;
        }
        .price-section h2 {
          font-size: 0.9rem;
          margin-bottom: 0.35rem;
        }
        .price-item p {
          font-size: 0.65rem;
        }
      }
      .container {
        max-width: 900px;
        margin: 0 auto;
        padding: 2rem;
        position: relative;
        z-index: 1;
      }
      .sidebar {
        position: fixed;
        left: 2rem;
        top: 2rem;
        width: auto;
        z-index: 1000;
        padding: 0;
        margin-bottom: 0;
      }
      .sidebar nav {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
      }
      .sidebar nav a {
        display: block;
        color: #222;
        text-decoration: none;
        font-weight: 500;
        text-transform: uppercase;
        font-family: inherit;
        letter-spacing: 0.01em;
        font-size: 0.85rem;
      }
      .sidebar nav a:hover { text-decoration: underline; }
      .main-content {
        max-width: 800px;
        margin: 0 auto;
        padding: 0;
      }
      h1 {
        font-size: 1.5rem;
        margin-bottom: 2rem;
        margin-top: 0;
      }
      .price-section {
        margin-bottom: 3rem;
      }
      .price-section h2 {
        font-size: 1.2rem;
        margin-bottom: 1rem;
        font-weight: 500;
      }
      .price-item {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        padding: 0.75rem 0;
        border-bottom: 1px solid #e0e0e0;
      }
      .price-item:last-child {
        border-bottom: none;
      }
      .price-name {
        font-weight: 500;
      }
      .price-description {
        font-size: 0.9rem;
        color: #666;
        margin-top: 0.25rem;
      }
      .price-amount {
        font-weight: 500;
        white-space: nowrap;
        margin-left: 2rem;
      }
      .giftcard-btn {
        background: #222;
        color: #fff;
        border: none;
        padding: 0.75rem 1.5rem;
        font-size: 1rem;
        text-transform: uppercase;
        letter-spacing: 0.01em;
        cursor: pointer;
        transition: opacity 0.3s ease;
        margin-top: 1rem;
      }
      .giftcard-btn:hover {
        opacity: 0.7;
      }
      .giftcard-modal {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        z-index: 10001;
        align-items: center;
        justify-content: center;
      }
      .giftcard-modal.open {
        display: flex;
      }
      .giftcard-modal-content {
        background: #fff;
        padding: 2rem;
        border-radius: 8px;
        max-width: 400px;
        width: 90%;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        position: relative;
        max-height: 90vh;
        overflow-y: auto;
      }
      .giftcard-modal-content h2 {
        margin-top: 0;
        padding-right: 2rem;
      }
      .giftcard-modal-content .form-group {
        margin-bottom: 1rem;
      }
      .giftcard-modal-content .form-group input[type="text"],
      .giftcard-modal-content .form-group input[type="email"],
      .giftcard-modal-content .form-group input[type="tel"],
      .giftcard-modal-content .form-group select {
        width: 100%;
        padding: 0.5rem;
        border: 1px solid #ddd;
        border-radius: 4px;
        font-family: inherit;
        font-size: 1rem;
      }
      .giftcard-modal-content .form-group label {
        display: block;
        margin-bottom: 0.5rem;
        font-weight: 500;
      }
      .giftcard-modal-content .form-group.checkbox label {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0;
      }
      .giftcard-modal-content .form-group.checkbox input[type="checkbox"] {
        width: auto;
      }
      .giftcard-modal-content .close-btn {
        position: absolute;
        top: 1rem;
        right: 1rem;
        background: none;
        border: none;
        font-size: 1.5rem;
        cursor: pointer;
        color: #999;
        padding: 0;
        width: 1.5rem;
        height: 1.5rem;
      }
      .giftcard-modal-content .close-btn:hover {
        color: #333;
      }
      .giftcard-modal-content .checkout-btn {
        background: #222;
        color: #fff;
        border: none;
        padding: 0.75rem 1.5rem;
        font-size: 1rem;
        text-transform: uppercase;
        letter-spacing: 0.01em;
        cursor: pointer;
        transition: opacity 0.3s ease;
      }
      .giftcard-modal-content .checkout-btn:hover {
        opacity: 0.7;
      }
      .giftcard-modal-content .checkout-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
      }
      .form-message {
        margin-top: 1rem;
        padding: 0.75rem;
        border-radius: 4px;
        text-align: center;
        font-size: 0.9rem;
        display: none;
      }
      .form-message.success {
        background: #e8f5e9;
        color: #2e7d32;
        display: block;
      }
      .form-message.error {
        background: #ffebee;
        color: #c62828;
        display: block;
      }
      .language-toggle {
        position: fixed;
        top: 1rem;
        right: 1rem;
        z-index: 10000;
        display: none;
        gap: 0.5rem;
      }
      .language-toggle button {
        background: transparent;
        border: none;
        padding: 0;
        font-size: 0.75rem;
        transition: opacity 0.2s ease;
        opacity: 0.3;
        cursor: pointer;
        font-weight: 500;
        color: #333;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }
      .language-toggle button:hover {
        opacity: 0.6;
      }
      .language-toggle button.active {
        opacity: 1;
      }
      @media (min-width: 769px) {
        .language-toggle {
          display: flex !important;
        }
      }
      @media (max-width: 768px) {
        .language-toggle {
          display: none !important;
        }
      }
    </style>
  </head>
  <body>
    <canvas id="letterfall-canvas"></canvas>
    <Logo />
    <Cursor />
    <HamburgerMenu />
    <div class="language-toggle">
      <button class="lang-btn active" data-lang="en">ENG</button>
      <button class="lang-btn" data-lang="et">EST</button>
    </div>
    <div class="container">
      <div class="sidebar">
        <nav>
          <a href="/" data-i18n="nav.home">HOME</a>
          <a href="/studio" data-i18n="nav.studio">STUDIO</a>
          <a href="/photos" data-i18n="nav.portraits">PHOTOS</a>
          <a href="/projects" data-i18n="nav.projects">PROJECTS</a>
          <a href="/prices" data-i18n="nav.prices">PRICES</a>
          <a href="/shop" data-i18n="nav.tshirts">SHOP</a>
          <a href="/contact" data-i18n="nav.contact">CONTACT</a>
        </nav>
      </div>
      <div class="main-content">
        <h1 data-i18n="prices.heading">Prices</h1>
        
        <div class="price-section">
          <h2 data-i18n="prices.portraitSessions">Portrait Sessions</h2>
          <div class="price-item">
            <div>
              <div class="price-name" data-i18n="prices.portraitSessionTwoMax">Studio portrait session</div>
              <div class="price-description" data-i18n="prices.individualPortraitDesc">1 hour session / 1 - 2 people max, 10+ edited photos</div>
            </div>
            <div class="price-amount" data-i18n="prices.portraitSessionTwoMaxPrice">€100</div>
          </div>
          <div class="price-item">
            <div>
              <div class="price-name" data-i18n="prices.portraitStudioSession">Studio portrait session</div>
              <div class="price-description" data-i18n="prices.portraitStudioSessionDesc">3-4 people, 1.5-2h session, 15+ edited photos</div>
            </div>
            <div class="price-amount" data-i18n="prices.portraitStudioSessionPrice">€150</div>
          </div>
        </div>

        <div class="price-section">
          <h2 data-i18n="prices.eventPhotography">Event Photography</h2>
          <div class="price-item">
            <div>
              <div class="price-name" data-i18n="prices.halfDay">Half Day</div>
              <div class="price-description" data-i18n="prices.halfDayDesc">Up to 4 hours coverage</div>
            </div>
            <div class="price-amount" data-i18n="prices.halfDayPrice">€350</div>
          </div>
          <div class="price-item">
            <div>
              <div class="price-name" data-i18n="prices.fullDay">Full Day</div>
              <div class="price-description" data-i18n="prices.fullDayDesc">Up to 8 hours coverage</div>
            </div>
            <div class="price-amount" data-i18n="prices.fullDayPrice">€600</div>
          </div>
        </div>

        <div class="price-section">
          <h2 data-i18n="prices.commercialProjects">Commercial Projects</h2>
          <div class="price-item">
            <div>
              <div class="price-name" data-i18n="prices.commercial">Commercial Rate</div>
              <div class="price-description" data-i18n="prices.commercialDesc">Custom quote based on project scope</div>
            </div>
            <div class="price-amount" data-i18n="prices.commercialPrice">Contact for quote</div>
          </div>
        </div>

        <div style="margin-top: 3rem; padding-top: 2rem; border-top: 1px solid #ddd;">
          <h2 data-i18n="prices.giftCards">Gift Cards</h2>
          <p data-i18n="prices.giftCardDescription">Purchase a gift card for photography sessions and share the gift of professional photography with someone special.</p>
          <button class="giftcard-btn" id="buyGiftcardBtn" data-i18n="prices.buyGiftCard">Buy a Gift Card</button>
        </div>

        <!-- Gift Card Modal -->
        <div class="giftcard-modal" id="giftcardModal">
          <div class="giftcard-modal-content">
            <button class="close-btn" id="closeModal">&times;</button>
            <h2 data-i18n="contact.selectGiftCardAmount">Select Gift Card Amount</h2>
            
            <div class="form-group">
              <label for="giftcardAmount" data-i18n="contact.amount">Amount</label>
              <select id="giftcardAmount" name="giftcardAmount">
                <option value="100">€100</option>
                <option value="150">€150</option>
              </select>
            </div>

            <div class="form-group">
              <label for="giftcardName"><span data-i18n="contact.name">Name</span> <span data-i18n="contact.required">*</span></label>
              <input type="text" id="giftcardName" name="giftcardName" required />
            </div>

            <div class="form-group">
              <label for="giftcardEmail"><span data-i18n="contact.email">Email</span> <span data-i18n="contact.required">*</span></label>
              <input type="email" id="giftcardEmail" name="giftcardEmail" required />
            </div>

            <div class="form-group">
              <label for="giftcardPhone" data-i18n="contact.phone">Phone</label>
              <input type="tel" id="giftcardPhone" name="giftcardPhone" />
            </div>

            <div class="form-group checkbox">
              <label for="giftcardDelivery">
                <input type="checkbox" id="giftcardDelivery" name="giftcardDelivery" />
                <span data-i18n="contact.deliveryOption">I want the gift card to be delivered</span>
              </label>
            </div>

            <div id="giftcardAddressFields" style="display: none;">
              <div class="form-group">
                <label for="giftcardAddress"><span data-i18n="contact.address">Address</span> <span data-i18n="contact.required">*</span></label>
                <input type="text" id="giftcardAddress" name="giftcardAddress" />
              </div>

              <div class="form-group">
                <label for="giftcardCity"><span data-i18n="contact.city">City</span> <span data-i18n="contact.required">*</span></label>
                <input type="text" id="giftcardCity" name="giftcardCity" />
              </div>

              <div class="form-group">
                <label for="giftcardPostal"><span data-i18n="contact.postal">Postal Code</span> <span data-i18n="contact.required">*</span></label>
                <input type="text" id="giftcardPostal" name="giftcardPostal" />
              </div>

              <div class="form-group">
                <label for="giftcardCountry"><span data-i18n="contact.country">Country</span> <span data-i18n="contact.required">*</span></label>
                <input type="text" id="giftcardCountry" name="giftcardCountry" />
              </div>
            </div>

            <button class="checkout-btn" id="checkoutBtn" data-i18n="contact.proceedToPayment">Proceed to Payment</button>
            <div id="giftcardMessage" class="form-message"></div>
          </div>
        </div>
      </div>
    </div>

    <script is:inline define:vars={{ translations }}>
      const currentLang = localStorage.getItem('language') || 'et';
      
      function applyTranslations(lang) {
        document.querySelectorAll('[data-i18n]').forEach(element => {
          const key = element.getAttribute('data-i18n');
          const keys = key.split('.');
          let value = translations[lang];
          
          for (const k of keys) {
            value = value?.[k];
          }
          
          if (value) {
            if (element.tagName === 'INPUT' || element.tagName === 'TEXTAREA') {
              element.placeholder = value;
            } else if (element.tagName === 'OPTION') {
              element.textContent = value;
            } else if (element.tagName === 'TITLE') {
              document.title = value;
            } else {
              element.textContent = value;
            }
          }
        });
        
        // Update active language button
        document.querySelectorAll('.lang-btn').forEach(btn => {
          btn.classList.toggle('active', btn.getAttribute('data-lang') === lang);
        });
        
        document.documentElement.lang = lang;
      }
      
      applyTranslations(currentLang);
      
      // Language toggle buttons
      document.querySelectorAll('.lang-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const lang = btn.getAttribute('data-lang');
          if (lang) {
            localStorage.setItem('language', lang);
            applyTranslations(lang);
          }
        });
      });

      // Gift Card Modal
      const buyGiftcardBtn = document.getElementById('buyGiftcardBtn');
      const closeModal = document.getElementById('closeModal');
      const giftcardModal = document.getElementById('giftcardModal');
      const checkoutBtn = document.getElementById('checkoutBtn');
      const giftcardDelivery = document.getElementById('giftcardDelivery');
      const giftcardAddressFields = document.getElementById('giftcardAddressFields');
      const giftcardMessage = document.getElementById('giftcardMessage');

      if (buyGiftcardBtn) {
        buyGiftcardBtn.addEventListener('click', () => {
          giftcardModal.classList.add('open');
        });
      }

      if (closeModal) {
        closeModal.addEventListener('click', () => {
          giftcardModal.classList.remove('open');
          giftcardMessage.className = 'form-message';
          giftcardMessage.textContent = '';
        });
      }

      if (giftcardModal) {
        giftcardModal.addEventListener('click', (e) => {
          if (e.target === giftcardModal) {
            giftcardModal.classList.remove('open');
            giftcardMessage.className = 'form-message';
            giftcardMessage.textContent = '';
          }
        });
      }

      if (giftcardDelivery) {
        giftcardDelivery.addEventListener('change', () => {
          giftcardAddressFields.style.display = giftcardDelivery.checked ? 'block' : 'none';
        });
      }

      if (checkoutBtn) {
        checkoutBtn.addEventListener('click', async () => {
          const amount = document.getElementById('giftcardAmount').value;
          const name = document.getElementById('giftcardName').value.trim();
          const email = document.getElementById('giftcardEmail').value.trim();
          const phone = document.getElementById('giftcardPhone').value.trim();
          const delivery = giftcardDelivery.checked;

          if (!name || !email) {
            giftcardMessage.className = 'form-message error';
            giftcardMessage.textContent = 'Please fill in all required fields';
            return;
          }

          if (delivery) {
            const address = document.getElementById('giftcardAddress').value.trim();
            const city = document.getElementById('giftcardCity').value.trim();
            const postal = document.getElementById('giftcardPostal').value.trim();
            const country = document.getElementById('giftcardCountry').value.trim();

            if (!address || !city || !postal || !country) {
              giftcardMessage.className = 'form-message error';
              giftcardMessage.textContent = 'Please fill in all delivery address fields';
              return;
            }
          }

          try {
            const response = await fetch('/api/stripe-checkout.json', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                type: 'giftcard',
                amount: parseInt(amount),
                name,
                email,
                phone,
                delivery,
                address: delivery ? document.getElementById('giftcardAddress').value : '',
                city: delivery ? document.getElementById('giftcardCity').value : '',
                postal: delivery ? document.getElementById('giftcardPostal').value : '',
                country: delivery ? document.getElementById('giftcardCountry').value : ''
              })
            });

            const data = await response.json();
            if (data.url) {
              window.location.href = data.url;
            } else {
              giftcardMessage.className = 'form-message error';
              giftcardMessage.textContent = 'Error processing payment. Please try again.';
            }
          } catch (error) {
            giftcardMessage.className = 'form-message error';
            giftcardMessage.textContent = 'Error processing payment. Please try again.';
            console.error('Error:', error);
          }
        });
      }
    </script>
    <script is:inline src="/scripts/letterfall.js"></script>
  </body>
</html>

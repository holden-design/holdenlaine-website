---
// Logo.astro: Persistent logo that appears on desktop pages
---

<a href="/" class="logo-link" title="Go to home">
  <img src="/logo.svg" alt="Holden Laine Logo" class="logo-image" />
</a>

<style is:global>
.logo-link {
  position: fixed !important;
  bottom: 2rem !important;
  left: 2rem !important;
  top: auto !important;
  z-index: 10000;
  width: 50px;
  height: 50px;
  cursor: pointer;
  transition: opacity 0.3s ease, transform 0.3s ease;
  display: block;
}

.logo-link:hover {
  opacity: 0.7;
  transform: scale(1.05);
}

.logo-image {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

/* Hide logo on mobile since it's in the header */
@media (max-width: 768px) {
  .logo-link {
    display: none;
  }
}
</style>

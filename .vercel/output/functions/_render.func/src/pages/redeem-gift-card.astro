---
import SEO from '../components/SEO.astro';
import Cursor from '../components/Cursor.astro';
import HamburgerMenu from '../components/HamburgerMenu.astro';
import MobileLogo from '../components/MobileLogo.astro';
import Logo from '../components/Logo.astro';
import translations from '../data/translations.json';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO 
      title="Redeem Gift Card"
      titleEt="Kasuta kinkekaart"
      description="Redeem your Holden Laine Photography gift card here."
      descriptionEt="Kasuta siin oma Holden Laine fotograafia kinkekaardi."
      type="website"
    />
    <style is:global>
      body {
        margin: 0;
        font-family: "Helvetica Neue", Helvetica;
        background: #fff;
        color: #222;
        display: block;
      }
    </style>

    <style>
      .container {
        max-width: 600px;
        margin: 4rem auto;
        padding: 2rem;
      }

      h1 {
        font-size: 2.5rem;
        margin-bottom: 2rem;
        text-transform: uppercase;
        letter-spacing: 0.02em;
      }

      .form-group {
        margin-bottom: 1.5rem;
      }

      label {
        display: block;
        margin-bottom: 0.5rem;
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.9rem;
        letter-spacing: 0.01em;
      }

      input {
        width: 100%;
        padding: 0.75rem;
        border: 1px solid #222;
        font-size: 1rem;
        font-family: "Helvetica Neue", Helvetica;
        box-sizing: border-box;
      }

      input:focus {
        outline: none;
        border-color: #000;
        background-color: #f5f5f5;
      }

      .redeem-btn {
        background: #222;
        color: #fff;
        padding: 0.75rem 2rem;
        border: none;
        font-size: 1rem;
        text-transform: uppercase;
        letter-spacing: 0.01em;
        cursor: pointer;
        transition: opacity 0.3s ease;
        width: 100%;
      }

      .redeem-btn:hover {
        opacity: 0.7;
      }

      .redeem-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
      }

      .message {
        margin-top: 1rem;
        padding: 1rem;
        border-radius: 4px;
        display: none;
      }

      .message.success {
        background-color: #d4edda;
        color: #155724;
        border: 1px solid #c3e6cb;
        display: block;
      }

      .message.error {
        background-color: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
        display: block;
      }

      .back-link {
        display: inline-block;
        margin-bottom: 2rem;
        text-decoration: none;
        color: #222;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.01em;
        border-bottom: 1px solid #222;
        transition: opacity 0.3s ease;
      }

      .back-link:hover {
        opacity: 0.7;
      }
    </style>
  </head>
  <body>
    <Cursor />
    <HamburgerMenu />
    <Logo />
    
    <div class="container">
      <a href="/" class="back-link">← Back</a>
      
      <h1>Redeem Gift Card</h1>
      
      <form id="redeemForm">
        <div class="form-group">
          <label for="giftcardCode">Gift Card Code</label>
          <input 
            type="text" 
            id="giftcardCode" 
            name="giftcardCode" 
            placeholder="e.g., 01-1111"
            required
          />
        </div>

        <div class="form-group">
          <label for="redeemEmail">Email Address</label>
          <input 
            type="email" 
            id="redeemEmail" 
            name="redeemEmail" 
            placeholder="your@email.com"
            required
          />
        </div>

        <button type="submit" class="redeem-btn">Redeem Gift Card</button>
      </form>

      <div id="redeemMessage" class="message"></div>
    </div>

    <script define:vars={{ translations }}>
      const form = document.getElementById('redeemForm');
      const messageEl = document.getElementById('redeemMessage');
      const codeInput = document.getElementById('giftcardCode');
      const emailInput = document.getElementById('redeemEmail');

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const code = codeInput.value.trim();
        const email = emailInput.value.trim();

        messageEl.className = 'message';
        messageEl.textContent = 'Processing...';

        try {
          const response = await fetch('/api/redeem-gift-card.json', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ code, email })
          });

          const data = await response.json();

          if (response.ok) {
            messageEl.className = 'message success';
            messageEl.textContent = data.message;
            form.reset();
          } else {
            messageEl.className = 'message error';
            messageEl.textContent = data.error || 'Something went wrong. Please try again.';
          }
        } catch (error) {
          console.error('Error:', error);
          messageEl.className = 'message error';
          messageEl.textContent = 'An error occurred. Please try again.';
        }
      });
    </script>
  </body>
</html>

{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/redeem-gift-card\\.json/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/stripe-checkout\\.json/?$",
			"dest": "_render"
		},
		{
			"src": "^/contact/?$",
			"dest": "_render"
		},
		{
			"src": "^/gift-card-success/?$",
			"dest": "_render"
		},
		{
			"src": "^/gift-cards/?$",
			"dest": "_render"
		},
		{
			"src": "^/photos/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/photos/?$",
			"dest": "_render"
		},
		{
			"src": "^/prices/?$",
			"dest": "_render"
		},
		{
			"src": "^/projects/?$",
			"dest": "_render"
		},
		{
			"src": "^/redeem-gift-card/?$",
			"dest": "_render"
		},
		{
			"src": "^/shop/?$",
			"dest": "_render"
		},
		{
			"src": "^/studio/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		}
	]
}